{
  "name": "plan-visualizer",
  "version": "1.0.0",
  "type": "module",
  "description": "Visualize DataFusion execution plans as interactive diagrams",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "tsc && vite build && vite preview",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "type-check": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test:e2e": "playwright test"
  },
  "keywords": [
    "react",
    "plan-visualizer",
    "datafusion",
    "excalidraw",
    "typescript",
    "tailwind",
    "pwa"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.0",
    "clsx": "^2.1.1",
    "idb": "^8.0.3",
    "lucide-react": "^0.294.0",
    "plan-viz": "^0.1.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.2",
    "tailwind-merge": "^2.6.0",
    "vite-plugin-pwa": "^1.1.0",
    "workbox-precaching": "^7.4.0",
    "workbox-window": "^7.4.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "^24.19.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/workbox-precaching": "^4.3.1",
    "@types/workbox-window": "^4.3.4",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "postcss": "^8.5.6",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.2.4"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "volta": {
    "node": "24.21.0"
  }
}
